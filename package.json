{
  "name": "size-limit-action",
  "version": "1.8.0",
  "private": true,
  "description": "size-limit action",
  "main": "dist/index.js",
  "license": "ISC",
  "scripts": {
    "format": "prettier --write **/*.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "build": "ncc build src/main.ts -o dist",
    "size-build": "npm run build",
    "size": "npm run size-build && size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "4500 ms"
    }
  ],
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.0.3",
    "@actions/github": "^6.0.1",
    "bytes": "^3.1.0",
    "has-pnpm": "^1.1.1",
    "has-yarn": "^2.1.0",
    "markdown-table": "^2.0.0"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@size-limit/time": "^11.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^12.7.12",
    "@typescript-eslint/parser": "^8.46.2",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.38.0",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jest": "^29.0.1",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "js-yaml": "^4.1.0",
    "prettier": "^1.19.1",
    "size-limit": "^11.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
